# Copy to .env and adjust for local development.

ENVIRONMENT=development

MCP_BASE_URL=http://localhost:8000
MCP_REQUEST_TIMEOUT_SECONDS=30

SESSION_TTL_SECONDS=3600

DEFAULT_UNITS=mm
DEFAULT_DISPLAY_SCALE=0.001

MAX_OBJECTS_PER_PROJECT=100
MAX_OPERATIONS_PER_PLAN=100
MAX_PROMPT_CHARACTERS=8000
ARTIFACT_CACHE_MAX_ENTRIES=200
ARTIFACT_CACHE_TTL_SECONDS=3600

# JSON array of allowed origins.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
