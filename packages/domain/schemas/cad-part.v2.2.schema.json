{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-x3d.local/schemas/cad-part.v2.2.schema.json",
  "title": "CadPartSpec v2.2: one fused L bracket with holes on both faces",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "units", "partId", "base", "features", "cornerChamfer", "upright"],
  "properties": {
    "schemaVersion": { "const": "2.2" },
    "units": { "const": "mm" },
    "partId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
    "base": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "width", "depth", "thickness"],
      "properties": {
        "kind": { "const": "extruded_rectangle" },
        "width": { "type": "number", "minimum": 0.1, "maximum": 10000 },
        "depth": { "type": "number", "minimum": 0.1, "maximum": 10000 },
        "thickness": { "type": "number", "minimum": 0.1, "maximum": 10000 }
      }
    },
    "features": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "id", "x", "y", "diameter"],
        "properties": {
          "kind": { "const": "through_hole" },
          "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "diameter": { "type": "number", "minimum": 0.1, "maximum": 10000 }
        }
      }
    },
    "cornerChamfer": { "const": 0 },
    "upright": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "height", "thickness", "holes"],
      "properties": {
        "kind": { "const": "upright_wall" },
        "height": { "type": "number", "minimum": 0.2, "maximum": 10000 },
        "thickness": { "type": "number", "minimum": 0.1, "maximum": 10000 },
        "holes": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "x", "z", "diameter"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
              "x": { "type": "number" },
              "z": { "type": "number" },
              "diameter": { "type": "number", "minimum": 0.1, "maximum": 10000 }
            }
          }
        }
      }
    }
  },
  "$comment": "The wall is fused along the rear Y edge. Wall height and Z hole coordinates are measured from the base bottom. Clearance and single-solid rules are enforced by domain and CAD validators."
}
