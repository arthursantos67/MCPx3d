        },
        "sweepAngle": {
          "default": 360,
          "exclusiveMinimum": 0,
          "maximum": 360,
          "title": "Sweepangle",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "count"
      ],
      "title": "CircularPattern",
      "type": "object"
    },
