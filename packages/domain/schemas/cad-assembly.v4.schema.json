{
  "$defs": {
    "BoxStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "op": {
          "enum": [
            "base",
            "union",
            "cut"
          ],
          "title": "Op",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Vector3"
        },
        "rotation": {
          "$ref": "#/$defs/Rotation3"
        },
        "pattern": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "circular": "#/$defs/CircularPattern",
                  "linear": "#/$defs/LinearPattern"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/CircularPattern"
                },
                {
                  "$ref": "#/$defs/LinearPattern"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "shape": {
          "const": "box",
          "title": "Shape",
          "type": "string"
        },
        "width": {
          "maximum": 10000,
          "minimum": 0.1,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "maximum": 10000,
          "minimum": 0.1,
          "title": "Depth",
          "type": "number"
        },
        "height": {
          "maximum": 10000,
          "minimum": 0.1,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "id",
        "op",
        "position",
        "rotation",
        "shape",
        "width",
        "depth",
        "height"
      ],
      "title": "BoxStep",
      "type": "object"
    },
    "CadComponent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Vector3"
        },
        "steps": {
          "items": {
            "discriminator": {
              "mapping": {
                "box": "#/$defs/BoxStep",
                "cone": "#/$defs/ConeStep",
                "cylinder": "#/$defs/CylinderStep",
                "polygon_prism": "#/$defs/PolygonStep",
                "revolve_profile": "#/$defs/RevolveStep",
                "sphere": "#/$defs/SphereStep"
              },
              "propertyName": "shape"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/BoxStep"
              },
              {
                "$ref": "#/$defs/CylinderStep"
              },
              {
                "$ref": "#/$defs/SphereStep"
              },
              {
                "$ref": "#/$defs/ConeStep"
              },
              {
                "$ref": "#/$defs/PolygonStep"
              },
              {
                "$ref": "#/$defs/RevolveStep"
              }
            ]
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "motion": {
          "anyOf": [
            {
              "$ref": "#/$defs/CadMotion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "position",
        "steps"
      ],
      "title": "CadComponent",
      "type": "object"
    },
    "CadMotion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "slider",
            "screw",
            "rotary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "axis": {
          "enum": [
            "x",
            "y",
            "z"
          ],
          "title": "Axis",
          "type": "string"
        },
        "minimum": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "Minimum",
          "type": "number"
        },
        "maximum": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "Maximum",
          "type": "number"
        },
        "value": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "Value",
          "type": "number"
        },
        "pitch": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch"
        },
        "group": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        }
      },
      "required": [
        "kind",
        "axis",
        "minimum",
        "maximum",
        "value"
      ],
      "title": "CadMotion",
      "type": "object"
    },
    "CircularPattern": {
      "additionalProperties": false,
