{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-x3d.local/schemas/cad-part.v2.3.schema.json",
  "title": "CadPartSpec v2.3: rounded plate or circular flange",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "units", "partId", "base", "features", "cornerChamfer", "cornerRadius"],
  "properties": {
    "schemaVersion": { "const": "2.3" },
    "units": { "const": "mm" },
    "partId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
    "base": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "width", "depth", "thickness"],
      "properties": {
        "kind": { "enum": ["extruded_rectangle", "extruded_disc"] },
        "width": { "type": "number", "minimum": 0.1, "maximum": 10000 },
        "depth": { "type": "number", "minimum": 0.1, "maximum": 10000 },
        "thickness": { "type": "number", "minimum": 0.1, "maximum": 10000 }
      }
    },
    "features": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "id", "x", "y", "diameter"],
        "properties": {
          "kind": { "const": "through_hole" },
          "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "diameter": { "type": "number", "minimum": 0.1, "maximum": 10000 }
        }
      }
    },
    "cornerChamfer": { "const": 0 },
    "cornerRadius": { "type": "number", "minimum": 0, "maximum": 5000 }
  },
  "$comment": "A disc uses width=depth=diameter and cornerRadius=0; a rounded rectangle uses cornerRadius>0. Domain and CAD validators enforce clearances and one solid."
}
