{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-x3d.local/schemas/cad-part.v2.schema.json",
  "title": "CadPartSpec v2: extruded rectangle with one through hole",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "units", "partId", "base", "features"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "units": { "const": "mm" },
    "partId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "width", "depth", "thickness"],
      "properties": {
        "kind": { "const": "extruded_rectangle" },
        "width": { "type": "number", "minimum": 0.1, "maximum": 10000 },
        "depth": { "type": "number", "minimum": 0.1, "maximum": 10000 },
        "thickness": { "type": "number", "minimum": 0.1, "maximum": 10000 }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "x", "y", "diameter"],
        "properties": {
          "kind": { "const": "through_hole" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "diameter": { "type": "number", "minimum": 0.1, "maximum": 10000 }
        }
      }
    }
  },
  "$comment": "Cross-field hole clearance is enforced by the Python domain validator."
}
