    "BoxStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Vector3"
        },
        "rotation": {
          "$ref": "#/$defs/Rotation3"
        },
        "pattern": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/CircularPattern"
                },
                {
                  "$ref": "#/$defs/LinearPattern"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "op": {
          "enum": [
            "base",
            "union",
            "cut"
          ],
          "title": "Op",
          "type": "string"
        },
        "shape": {
          "const": "box",
          "title": "Shape",
          "type": "string"
        },
        "width": {
          "maximum": 10000,
          "minimum": 0.1,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "maximum": 10000,
          "minimum": 0.1,
          "title": "Depth",
          "type": "number"
        },
        "height": {
          "maximum": 10000,
          "minimum": 0.1,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "id",
        "position",
        "rotation",
        "op",
        "shape",
        "width",
        "depth",
        "height"
      ],
      "title": "BoxStep",
      "type": "object"
    },
