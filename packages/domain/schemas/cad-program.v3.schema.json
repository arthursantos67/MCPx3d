{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "units", "partId", "steps"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "units": { "const": "mm" },
    "partId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "steps": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "oneOf": [
      { "$ref": "#/$defs/box" }, { "$ref": "#/$defs/cylinder" },
      { "$ref": "#/$defs/sphere" }, { "$ref": "#/$defs/cone" }, { "$ref": "#/$defs/polygon" }, { "$ref": "#/$defs/revolve" }
    ] } }
  },
  "$defs": {
    "vector": { "type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": {
      "x": { "type": "number", "minimum": -10000, "maximum": 10000 },
      "y": { "type": "number", "minimum": -10000, "maximum": 10000 },
      "z": { "type": "number", "minimum": -10000, "maximum": 10000 }
    } },
    "rotation": { "type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": {
      "x": { "type": "number", "minimum": -360, "maximum": 360 },
      "y": { "type": "number", "minimum": -360, "maximum": 360 },
      "z": { "type": "number", "minimum": -360, "maximum": 360 }
    } },
    "pattern": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "count"], "properties": {
        "kind": { "const": "circular" }, "count": { "type": "integer", "minimum": 2, "maximum": 64 },
        "axis": { "enum": ["x", "y", "z"] }, "center": { "$ref": "#/$defs/vector" },
        "sweepAngle": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 }
      } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "count", "offset"], "properties": {
        "kind": { "const": "linear" }, "count": { "type": "integer", "minimum": 2, "maximum": 64 },
        "offset": { "$ref": "#/$defs/vector" }
      } }
    ] },
    "box": { "type": "object", "additionalProperties": false,
      "required": ["id", "op", "shape", "position", "rotation", "width", "depth", "height"],
      "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }, "op": { "enum": ["base", "union", "cut"] }, "shape": { "const": "box" },
        "position": { "$ref": "#/$defs/vector" }, "rotation": { "$ref": "#/$defs/rotation" },
        "width": { "type": "number", "minimum": 0.1, "maximum": 10000 }, "depth": { "type": "number", "minimum": 0.1, "maximum": 10000 }, "height": { "type": "number", "minimum": 0.1, "maximum": 10000 }, "pattern": { "$ref": "#/$defs/pattern" } } },
    "cylinder": { "type": "object", "additionalProperties": false, "required": ["id", "op", "shape", "position", "rotation", "diameter", "height"],
      "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }, "op": { "enum": ["base", "union", "cut"] }, "shape": { "const": "cylinder" },
        "position": { "$ref": "#/$defs/vector" }, "rotation": { "$ref": "#/$defs/rotation" },
        "diameter": { "type": "number", "minimum": 0.1, "maximum": 10000 }, "height": { "type": "number", "minimum": 0.1, "maximum": 10000 }, "pattern": { "$ref": "#/$defs/pattern" } } },
    "sphere": { "type": "object", "additionalProperties": false, "required": ["id", "op", "shape", "position", "rotation", "diameter"],
      "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }, "op": { "enum": ["base", "union", "cut"] }, "shape": { "const": "sphere" },
        "position": { "$ref": "#/$defs/vector" }, "rotation": { "$ref": "#/$defs/rotation" },
        "diameter": { "type": "number", "minimum": 0.1, "maximum": 10000 }, "pattern": { "$ref": "#/$defs/pattern" } } },
    "cone": { "type": "object", "additionalProperties": false, "required": ["id", "op", "shape", "position", "rotation", "bottomDiameter", "topDiameter", "height"],
      "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }, "op": { "enum": ["base", "union", "cut"] }, "shape": { "const": "cone" },
        "position": { "$ref": "#/$defs/vector" }, "rotation": { "$ref": "#/$defs/rotation" },
        "bottomDiameter": { "type": "number", "minimum": 0.1, "maximum": 10000 }, "topDiameter": { "type": "number", "minimum": 0, "maximum": 10000 }, "height": { "type": "number", "minimum": 0.1, "maximum": 10000 }, "pattern": { "$ref": "#/$defs/pattern" } } },
    "polygon": { "type": "object", "additionalProperties": false, "required": ["id", "op", "shape", "position", "rotation", "points", "height"],
      "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }, "op": { "enum": ["base", "union", "cut"] }, "shape": { "const": "polygon_prism" },
        "position": { "$ref": "#/$defs/vector" }, "rotation": { "$ref": "#/$defs/rotation" },
        "points": { "type": "array", "minItems": 3, "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {
          "x": { "type": "number", "minimum": -10000, "maximum": 10000 }, "y": { "type": "number", "minimum": -10000, "maximum": 10000 }
        } } }, "height": { "type": "number", "minimum": 0.1, "maximum": 10000 }, "pattern": { "$ref": "#/$defs/pattern" } } },
    "revolve": { "type": "object", "additionalProperties": false, "required": ["id", "op", "shape", "position", "rotation", "points"],
      "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }, "op": { "enum": ["base", "union", "cut"] }, "shape": { "const": "revolve_profile" },
        "position": { "$ref": "#/$defs/vector" }, "rotation": { "$ref": "#/$defs/rotation" },
        "points": { "type": "array", "minItems": 3, "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {
          "x": { "type": "number", "minimum": 0, "maximum": 10000 }, "y": { "type": "number", "minimum": -10000, "maximum": 10000 }
        } } }, "pattern": { "$ref": "#/$defs/pattern" } } }
  }
}
