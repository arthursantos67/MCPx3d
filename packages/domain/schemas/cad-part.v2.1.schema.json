{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-x3d.local/schemas/cad-part.v2.1.schema.json",
  "title": "CadPartSpec v2.1: chamfered plate with identified through holes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "units", "partId", "base", "features", "cornerChamfer"],
  "properties": {
    "schemaVersion": { "const": "2.1" },
    "units": { "const": "mm" },
    "partId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "width", "depth", "thickness"],
      "properties": {
        "kind": { "const": "extruded_rectangle" },
        "width": { "type": "number", "minimum": 0.1, "maximum": 10000 },
        "depth": { "type": "number", "minimum": 0.1, "maximum": 10000 },
        "thickness": { "type": "number", "minimum": 0.1, "maximum": 10000 }
      }
    },
    "features": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "id", "x", "y", "diameter"],
        "properties": {
          "kind": { "const": "through_hole" },
          "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "diameter": { "type": "number", "minimum": 0.1, "maximum": 10000 }
        }
      }
    },
    "cornerChamfer": { "type": "number", "minimum": 0, "maximum": 2500 }
  },
  "$comment": "Clearances, unique IDs and the chamfer side limit are enforced by domain validators."
}
